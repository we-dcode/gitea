# Multi-arch build (linux/amd64 + linux/arm64) without an emulated toolchain.
# The build stage always runs on the build host's own platform ($BUILDPLATFORM):
# the frontend and the generated Go sources are platform-independent, and the
# gitea binary is cross-compiled for $TARGETPLATFORM with tonistiigi/xx
# (clang + a target musl sysroot; cgo is needed for sqlite). Only the small
# runtime stage below runs as the target platform.
FROM --platform=$BUILDPLATFORM docker.io/tonistiigi/xx:1.6.1 AS xx

#Build stage
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.20-alpine3.18 AS build-env

ARG GOPROXY
ENV GOPROXY ${GOPROXY:-direct}

ARG GITEA_VERSION
ARG TAGS="sqlite sqlite_unlock_notify"
ENV TAGS "bindata timetzdata $TAGS"
ARG CGO_EXTRA_CFLAGS

#Build deps
RUN apk --no-cache add build-base git nodejs npm clang lld
COPY --from=xx / /

#Setup repo
COPY . ${GOPATH}/src/code.gitea.io/gitea
WORKDIR ${GOPATH}/src/code.gitea.io/gitea

#Checkout version if set, then build everything that does not depend on the
#target platform (frontend assets + go generate / bindata) natively, once.
RUN if [ -n "${GITEA_VERSION}" ]; then git checkout "${GITEA_VERSION}"; fi \
 && make clean-all frontend go-check generate-backend

#Cross-compile the backend and env-to-ini for the target platform
ARG TARGETPLATFORM
RUN xx-apk add --no-cache gcc musl-dev
# Version string baked into the binary. By default the Makefile takes it from
# `git describe`; pass it when the build context has no usable .git directory
# (a git worktree, for example), e.g. GITEA_BUILD_VERSION=1.20.3+10-gabcdef012
ARG GITEA_BUILD_VERSION
RUN CGO_ENABLED=1 make GO=xx-go ${GITEA_BUILD_VERSION:+GITEA_VERSION=$GITEA_BUILD_VERSION} gitea \
 && CGO_ENABLED=1 xx-go build contrib/environment-to-ini/environment-to-ini.go \
 && xx-verify gitea environment-to-ini

FROM docker.io/library/alpine:3.18
LABEL maintainer="maintainers@gitea.io"

EXPOSE 2222 3000

RUN apk --no-cache add \
    bash \
    ca-certificates \
    dumb-init \
    gettext \
    git \
    curl \
    gnupg

RUN addgroup \
    -S -g 1000 \
    git && \
  adduser \
    -S -H -D \
    -h /var/lib/gitea/git \
    -s /bin/bash \
    -u 1000 \
    -G git \
    git

RUN mkdir -p /var/lib/gitea /etc/gitea
RUN chown git:git /var/lib/gitea /etc/gitea

COPY docker/rootless /
COPY --from=build-env --chown=root:root /go/src/code.gitea.io/gitea/gitea /app/gitea/gitea
COPY --from=build-env --chown=root:root /go/src/code.gitea.io/gitea/environment-to-ini /usr/local/bin/environment-to-ini
COPY --from=build-env /go/src/code.gitea.io/gitea/contrib/autocompletion/bash_autocomplete /etc/profile.d/gitea_bash_autocomplete.sh
RUN chmod 755 /usr/local/bin/docker-entrypoint.sh /usr/local/bin/docker-setup.sh /app/gitea/gitea /usr/local/bin/gitea /usr/local/bin/environment-to-ini
RUN chmod 644 /etc/profile.d/gitea_bash_autocomplete.sh

#git:git
USER 1000:1000
ENV GITEA_WORK_DIR /var/lib/gitea
ENV GITEA_CUSTOM /var/lib/gitea/custom
ENV GITEA_TEMP /tmp/gitea
ENV TMPDIR /tmp/gitea

#TODO add to docs the ability to define the ini to load (useful to test and revert a config)
ENV GITEA_APP_INI /etc/gitea/app.ini
ENV HOME "/var/lib/gitea/git"
VOLUME ["/var/lib/gitea", "/etc/gitea"]
WORKDIR /var/lib/gitea

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD []

